<!DOCTYPE module SYSTEM "module.dtd">

<module name="visual_servoing" dir="visual_servoing">
  <doc>
    <description>
    Exercise module for Autonomous Flight of MAV Course
    </description>
    <section name="VS" prefix="VS_">
      <define name="NOM_THROTTLE" value="0.676" description="nominal throttle"/>
      <define name="SET_POINT" value="0.1" description="divergence set-point"/>
      <define name="OL_X_PGAIN" value="0.1" description="outer loop x proportional gain"/>
      <define name="OL_X_IGAIN" value="0" description="outer loop x integral gain"/>
      <define name="OL_Y_OF_GAIN" value="3.2" description="outer loop y optic flow gain"/>
      <define name="OL_Y_YAW_GAIN" value="3.2" description="outer loop y yawVel gain"/>
      <define name="OL_Z_PGAIN" value="7.5" description="outer loop z proportional gain"/>
      <define name="OL_Z_DGAIN" value="0.0075" description="outer loop z derivative gain"/>
      <define name="OL_Z_PFF" value="10.0" description="outer loop z feedforward"/>
      <define name="OL_Z_SP" value="1.1" description="height setpoint"/>
      <define name="OL_X_VEL_SP" value="0.0" description="approach speed setpoint"/>
      <define name="LP_CONST" value="0.2" description="Low pass filter constant"/>
      <define name="SWITCH_MAGNITUDE" value="1" description="Switch magnitude"/>
      <define name="SWITCH_DECAY" value="1.2" description="Decay parameter of the standard set-point switching maneuver"/>
      <define name="THETA_OFFSET" value="0.01" description="offset for theta"/>
      <define name="CC_THRESHOLD" value="5000" description="Threshold of orange pixels for manual switching to new set-point"/>
      <define name="NEW_SET_POINT" value="0.3" description="New divergence set-point when switching is set to manual"/>
      <!--
        ==========================================================
        Flight mode and legacy experiment selection
        ==========================================================
      -->

      <define
        name="MANUAL_SWITCHING"
        value="0"
        description="Enable manual visual-servo switching"/>

      <define
        name="APPROACH_MODE"
        value="3"
        description="Visual-servo approach mode"/>

      <define
        name="ABLATION_MODE"
        value="0"
        description="Visual-servo ablation mode"/>

      <define
        name="OL_Y_OA_GAIN"
        value="0.0"
        description="Legacy lateral obstacle-avoidance gain"/>

      <define
        name="OL_X_VEL_PGAIN"
        value="10.0"
        description="Legacy forward velocity proportional gain"/>


      <!--
        ==========================================================
        Forward position PID controller
        ==========================================================
      -->

      <define
        name="FWD_KP"
        value="0.80"
        description="Forward position proportional gain"/>

      <define
        name="FWD_KD"
        value="2.00"
        description="Forward velocity damping gain"/>

      <define
        name="FWD_KI"
        value="0.03"
        description="Forward position integral gain"/>

      <define
        name="FIXED_PITCH_TRIM_DEG"
        value="-1.95"
        description="Fixed aircraft-specific pitch feedforward in degrees"/>

      <define
        name="FWD_I_MAX_ACCEL"
        value="0.08"
        description="Maximum forward integral acceleration contribution"/>

      <define
        name="FWD_MAX_ACCEL"
        value="0.40"
        description="Maximum total forward PID acceleration command"/>


      <!--
        ==========================================================
        Lateral controller
        ==========================================================
      -->

      <define
        name="OF_SCALE"
        value="0.005"
        description="Scale factor applied to lateral optic flow"/>

      <define
        name="LAT_MAX_ACCEL"
        value="0.30"
        description="Maximum lateral acceleration command"/>

      <define
        name="LAT_FALLBACK_KD"
        value="0.80"
        description="Lateral velocity damping during target loss or startup"/>

      <define
        name="ACCEL_SLEW"
        value="1.00"
        description="Horizontal acceleration-command slew rate"/>


      <!--
        ==========================================================
        Vision validity
        ==========================================================
      -->

      <define
        name="VISION_MIN_DT"
        value="0.005"
        description="Minimum accepted interval between visual samples"/>

      <define
        name="VISION_MAX_DT"
        value="0.25"
        description="Maximum accepted interval between visual samples"/>

      <define
        name="VISION_TIMEOUT"
        value="0.15"
        description="Timeout for the most recent valid visual sample"/>

      <define
        name="VISION_MIN_STREAK"
        value="5"
        description="Consecutive valid visual frames required for OF actuation"/>


      <!--
        ==========================================================
        Attitude-command safety limits
        ==========================================================
      -->

      <define
        name="MAX_PITCH_DEG"
        value="4.0"
        description="Maximum absolute pitch command in degrees"/>

      <define
        name="MAX_ROLL_DEG"
        value="4.0"
        description="Maximum absolute roll command in degrees"/>

      <!--
        ==========================================================
        Settle-before-activation gate
        ==========================================================
      -->

      <define
        name="SETTLE_FWD_SPEED_MAX"
        value="0.015"
        description="Maximum absolute forward speed before visual-servo activation"/>

      <define
        name="SETTLE_RIGHT_SPEED_MAX"
        value="0.025"
        description="Maximum absolute rightward speed before visual-servo activation"/>

      <define
        name="SETTLE_RAW_RIGHT_SPEED_MAX"
        value="0.020"
        description="Maximum absolute rightward speed before visual-servo activation"/>

      <define
        name="SETTLE_VERTICAL_SPEED_MAX"
        value="0.030"
        description="Maximum absolute vertical speed before visual-servo activation"/>

      <define
        name="SETTLE_HORIZONTAL_POS_MAX"
        value="0.050"
        description="Maximum horizontal distance from the captured NAV target before visual-servo activation"/>

      <define
        name="SETTLE_VERTICAL_POS_MAX"
        value="0.050"
        description="Maximum absolute height error before visual-servo activation"/>

      <define
        name="SETTLE_DWELL_TIME"
        value="0.3"
        description="Continuous settled duration required before visual-servo activation"/>
    </section>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="VisualServoing">
        <dl_setting var="visual_servoing.nominal_throttle" min="0" step="0.001" max="0.8" module="visual_servoing/visual_servoing" shortname="nominal_throttle" param="VS_NOM_THROTTLE"/>
        <dl_setting var="visual_servoing.set_point" min="0" step="0.01" max="1" module="visual_servoing/visual_servoing" shortname="set_point" param="VS_SET_POINT"/>
        <dl_setting var="visual_servoing.ol_x_pgain" min="0" step="0.1" max="15" module="visual_servoing/visual_servoing" shortname="ol_x_pgain" param="VS_OL_X_PGAIN"/>
        <dl_setting var="visual_servoing.ol_x_igain" min="0" step="0.001" max="1" module="visual_servoing/visual_servoing" shortname="ol_x_igain" param="VS_OL_X_IGAIN"/>
        <dl_setting var="visual_servoing.ol_y_OF_gain" min="0" step="0.01" max="10" module="visual_servoing/visual_servoing" shortname="ol_y_OF_gain" param="VS_OL_Y_OF_GAIN"/>
        <dl_setting var="visual_servoing.ol_y_YAW_gain" min="0" step="0.01" max="10" module="visual_servoing/visual_servoing" shortname="ol_y_YAW_gain" param="VS_OL_Y_YAW_GAIN"/>
        <dl_setting var="visual_servoing.ol_z_pgain" min="0" step="0.1" max="30.0" module="visual_servoing/visual_servoing" shortname="ol_z_pgain" param="VS_OL_Z_PGAIN"/>
        <dl_setting var="visual_servoing.ol_z_dgain" min="0" step="0.0001" max="0.030" module="visual_servoing/visual_servoing" shortname="ol_z_dgain" param="VS_OL_Z_DGAIN"/>
        <dl_setting var="visual_servoing.ol_z_pff" min="-20" step="1.0" max="100" module="visual_servoing/visual_servoing" shortname="ol_z_pff" param="VS_OL_Z_PFF"/>
        <dl_setting var="visual_servoing.height_setpoint" min="0.2" step="0.1" max="2.0" module="visual_servoing/visual_servoing" shortname="height_setpoint" param="VS_OL_Z_SP"/>
        <dl_setting var="visual_servoing.vel_x_sp" min="-0.10" step="0.01" max="0.0" module="visual_servoing/visual_servoing" shortname="vel_x_sp" param="VS_OL_X_VEL_SP"/>
        <dl_setting var="visual_servoing.lp_const" min="0" step="0.1" max="100" module="visual_servoing/visual_servoing" shortname="lp_const" param="VS_LP_CONST"/>
        <dl_setting var="visual_servoing.switch_magnitude" min="0" step="0.1" max="3" module="visual_servoing/visual_servoing" shortname="switch_magnitude" param="VS_SWITCH_MAGNITUDE"/>
        <dl_setting var="visual_servoing.switch_decay" min="0" step="0.1" max="3" module="visual_servoing/visual_servoing" shortname="switch_decay" param="VS_SWITCH_DECAY"/>
        <dl_setting var="visual_servoing.theta_offset" min="-1" step="0.001" max="1" module="visual_servoing/visual_servoing" shortname="theta_offset" param="VS_THETA_OFFSET"/>
        <dl_setting var="visual_servoing.color_count_threshold" min="0" step="1000" max="50000" module="visual_servoing/visual_servoing" shortname="cc_threshold" param="VS_CC_THRESHOLD"/>
        <dl_setting var="visual_servoing.new_set_point" min="0" step="0.01" max="1" module="visual_servoing/visual_servoing" shortname="new_set_point" param="VS_NEW_SET_POINT"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>cv_detect_color_object</depends>
  </dep>

  <header>
    <file name="visual_servoing.h"/>
  </header>
  
  <!--
    Always process VISUAL_DETECTION samples, even while the aircraft
    remains in ordinary NAV/HOVER. This observer never writes commands.
  -->
  <periodic fun="visual_servoing_observer_periodic()" freq="128"/>
  
  <makefile target="ap|nps">
    <file name="visual_servoing.c"/>
    <define name="VISUAL_SERVOING_CAMERA" value="front_camera"/>
  </makefile>
</module>