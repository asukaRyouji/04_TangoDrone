<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="moving_flower">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="flower_link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <pose>0 0 0 0 0 0</pose>
      <visual name="flower_visual">
        <geometry>
          <mesh>
            <uri>model://moving_flower/moving_flower.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="flower_collision">
        <geometry>
          <box>
            <size>0.15 0.15 0.003</size>
          </box>
        </geometry>
      </collision>
    </link>

    <plugin name="flower_motion" filename="/home/admin_user/Desktop/04_TangoDrone/paparazzi/sw/ext/flower_motion_plugin/build/libflower_motion.so">
      <amplitude>0.3</amplitude>
      <frequency>0.50</frequency>
      <axis>x</axis>
      <start_delay>15.0</start_delay>
    </plugin>

  </model>
</sdf>